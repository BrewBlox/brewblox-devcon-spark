FROM python:3.11-bookworm AS base

ENV PIP_EXTRA_INDEX_URL=https://www.piwheels.org/simple
ENV PIP_FIND_LINKS=/wheeley
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
ADD https://astral.sh/uv/install.sh /install.sh
RUN chmod -R 655 /install.sh && /install.sh && rm /install.sh

COPY ./ /app/
WORKDIR /app
RUN /root/.local/bin/uv venv "$VIRTUAL_ENV"
RUN /root/.local/bin/uv sync --no-dev --no-editable

RUN <<EOF bash
    set -ex

    cd /app/firmware
    ARCH="$(dpkg --print-architecture)"
    if [ "\${ARCH}" = "amd64" ]; then
        rm ./brewblox-{arm32,arm64}.sim
    elif [ "\${ARCH}" = "armhf" ]; then
        rm ./brewblox-{amd64,arm64}.sim
    elif [ "\${ARCH}" = "arm64" ]; then
        rm ./brewblox-{amd64,arm32}.sim
    fi
EOF

FROM python:3.11-slim-bookworm
EXPOSE 5000
WORKDIR /app

ENV PIP_FIND_LINKS=/wheeley
ENV VENV=/app/.venv
ENV PATH="$VENV/bin:$PATH"

COPY --from=base /app/.venv /app/.venv
COPY --from=base /app/firmware /app/firmware
COPY ./parse_appenv.py ./parse_appenv.py
COPY ./entrypoint.sh ./entrypoint.sh

ENTRYPOINT ["bash", "./entrypoint.sh"]
