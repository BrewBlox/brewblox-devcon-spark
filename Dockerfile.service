FROM python:3.11-bookworm AS base

# Declare a build argument for the target architecture
ARG TARGETPLATFORM

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy RUST_LOG=info
# Pinned installer: the uv release image has no linux/arm/v7 manifest.
ADD https://astral.sh/uv/0.11.23/install.sh /uv-installer.sh
RUN UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh /uv-installer.sh && rm /uv-installer.sh

COPY ./ /app
WORKDIR /app

RUN uv venv

# Wheels only: building under QEMU is slow, and fails for packages that need Rust.
# aiozeroconf is the exception: pure Python, but only released as source.
# The package itself is not installed: uvicorn imports it from /app.
# On arm/v7, piwheels serves the armv7l wheels that PyPI lacks; unsafe-best-match
# lets uv fall back to PyPI for versions piwheels does not have, instead of
# refusing once a package exists there. arm64 and amd64 are served by PyPI alone.
RUN if [ "$TARGETPLATFORM" = "linux/arm/v7" ]; then \
    INDEX="--index=https://www.piwheels.org/simple --index-strategy=unsafe-best-match"; \
    fi; \
    uv export --no-hashes --no-dev --no-emit-project | \
    uv pip sync --verbose --only-binary=:all: --no-binary=aiozeroconf ${INDEX:-} -

# A missing compiled protobuf wheel silently installs the pure-Python implementation,
# which costs 18-30% more CPU per broadcast (measured on amd64).
RUN .venv/bin/python -c "from google.protobuf.internal import api_implementation as a; assert a.Type() == 'upb', a.Type()"

RUN ARCH="$(dpkg --print-architecture)"; \
    set -ex; \
    cd /app/firmware; \
    if [ "$ARCH" = "amd64" ]; then \
    echo "Building for amd64"; \
    rm -f brewblox-arm32.sim; rm -f brewblox-arm64.sim; \
    elif [ "$ARCH" = "armhf" ]; then \
    echo "Building for armhf"; \
    rm -f brewblox-amd64.sim; rm -f brewblox-arm64.sim; \
    elif [ "$ARCH" = "arm64" ]; then \
    echo "Building for arm64"; \
    rm -f ./brewblox-amd64.sim; rm -f brewblox-arm32.sim; \
    fi;

FROM python:3.11-slim-bookworm
EXPOSE 5000
WORKDIR /app

# The service runs from its own venv: the system pip and setuptools only add vulnerabilities
RUN python -m pip uninstall --yes pip setuptools wheel

ENV VENV=/app/.venv
ENV PATH="$VENV/bin:$PATH"

COPY --from=base /app/.venv /app/.venv
COPY ./brewblox_devcon_spark /app/brewblox_devcon_spark
COPY --from=base /app/firmware /app/firmware
COPY ./parse_appenv.py ./parse_appenv.py
COPY ./entrypoint.sh ./entrypoint.sh

ENTRYPOINT ["bash", "./entrypoint.sh"]
