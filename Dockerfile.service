FROM python:3.11-bookworm AS base

# Declare a build argument for the target architecture
ARG TARGETPLATFORM

# ENV PIP_FIND_LINKS=/wheeley
#ENV VIRTUAL_ENV=/app/.venv
#ENV PATH="$VIRTUAL_ENV/bin:$PATH"
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
ADD https://astral.sh/uv/install.sh /install.sh
RUN chmod -R 655 /install.sh && /install.sh && rm /install.sh
# echo uv version
RUN /root/.local/bin/uv --version

# COPY ./brewblox_devcon_spark /app/brewblox_devcon_spark
# COPY pyproject.toml /app/pyproject.toml
# # COPY uv.lock /app/uv.lock
# COPY firmware.ini /app/firmware.ini
# COPY firmware /app/firmware
COPY . /app

WORKDIR /app
RUN /root/.local/bin/uv venv
RUN if [ "$TARGETPLATFORM" = "linux/arm/v7" ] || [ "$TARGETPLATFORM" = "linux/arm64" ]; then \
    /root/.local/bin/uv export --no-hashes --no-dev --output-file requirements.txt --default-index=https://www.piwheels.org/simple; \
    /root/.local/bin/uv pip sync --verbose requirements.txt --default-index=https://www.piwheels.org/simple; \
    else \
    /root/.local/bin/uv export --no-hashes --no-build --no-dev --output-file requirements.txt; \
    /root/.local/bin/uv pip sync --verbose requirements.txt; \
    fi

RUN <<EOF bash
    set -ex

    cd /app/firmware
    ARCH="$(dpkg --print-architecture)"
    if [ "\${ARCH}" = "amd64" ]; then
        rm ./brewblox-{arm32,arm64}.sim
    elif [ "\${ARCH}" = "armhf" ]; then
        rm ./brewblox-{amd64,arm64}.sim
    elif [ "\${ARCH}" = "arm64" ]; then
        rm ./brewblox-{amd64,arm32}.sim
    fi
EOF

FROM python:3.11-slim-bookworm
EXPOSE 5000
WORKDIR /app

ENV PIP_FIND_LINKS=/wheeley
ENV VENV=/app/.venv
ENV PATH="$VENV/bin:$PATH"

COPY --from=base /app/.venv /app/.venv
COPY ./brewblox_devcon_spark /app/brewblox_devcon_spark
COPY --from=base /app/firmware /app/firmware
COPY ./parse_appenv.py ./parse_appenv.py
COPY ./entrypoint.sh ./entrypoint.sh

ENTRYPOINT ["bash", "./entrypoint.sh"]
