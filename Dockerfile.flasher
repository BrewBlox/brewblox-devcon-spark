# syntax=docker/dockerfile:1-labs
FROM python:3.13-slim-trixie

ENV PIP_EXTRA_INDEX_URL=https://www.piwheels.org/simple

WORKDIR /app

RUN <<EOF bash
    set -ex

    # Install only runtime dependencies
    apt-get update -q
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libatomic1 \
        usbutils

    # Install Python dependencies using only pre-built wheels.
    # cryptography comes from PyPI: its armv7 wheel includes OpenSSL, while the piwheels
    # build links the system OpenSSL, with a different time_t size on 32-bit trixie.
    PIP_EXTRA_INDEX_URL= pip3 install --only-binary=:all: cryptography
    # esptool is only released as source on PyPI: piwheels serves it as a wheel.
    # The flash script uses the underscore spelling that esptool 5 deprecated.
    pip3 install --only-binary=:all: "esptool>=5,<6"

    # Install Particle CLI
    CLI_VERSION="3.29.1"
    ARCH="$(dpkg --print-architecture)"
    if [ "\${ARCH}" = "amd64" ]; then
        CLI_ARCH="x64"
    elif [ "\${ARCH}" = "armhf" ]; then
        CLI_ARCH="arm"
    elif [ "\${ARCH}" = "arm64" ]; then
        CLI_ARCH="arm64"
    fi

    curl -sSL \
        -o ./particle.gz \
        "https://binaries.particle.io/particle-cli/\${CLI_VERSION}/linux/\${CLI_ARCH}/particle.gz"
    gunzip ./particle.gz
    chmod +x ./particle
    mv ./particle /usr/local/bin/

    # Clean up
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/cache/apt/archives /var/lib/apt/lists
EOF

COPY --exclude=*.sim firmware/ ./

ENTRYPOINT [ "/bin/bash" ]
